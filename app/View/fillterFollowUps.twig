        outline: none;
        cursor: pointer;
    }

    #resetBtn{
        width: 130px;
        height: 35px;
        text-align: center;
        color: white;
        border-radius: 7px;
        background-color: red;
        border: none;
        outline: none;
        cursor: pointer;
    }

