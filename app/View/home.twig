{% extends "layout.twig" %}

{% block content %}

    <div class="container">
        <h1 style="text-align: center;">FollowUp Management</h1>

        <p>Manage your customer follow-ups</p>

        <h2>Follow-ups</h2>

        <button id="openModal" type="button">New Follow-up</button>
        <div class="table-responsive">
        <table  class="followup-table" border="1" cellpadding="10" cellspacing="0">
            <thead>
            <tr>
                <th>ID</th>
                <th>Customer ID</th>
                <th>Title</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Due Date</th>
                <th>Creator ID</th>
                <th>Reopen</th>
                <th>Complete</th>
            </tr>
            </thead>

            <tbody id="followups">
            </tbody>
        </table>
        </div>
    </div>

    {% include "modalForm.twig" %}
    <script type="text/javascript" src="/assets/script.js"></script>
{% endblock %}